# Server-side secrets. Set these in Vercel → Settings → Environment Variables
# with type "Secret". They are used only by the serverless functions in /api
# and are NEVER exposed to the browser. Do NOT add a VITE_ prefix.
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here   # optional

# Optional client config (safe to expose — it is just a URL).
# Leave empty for the web app. Set to the deployed URL for the Capacitor/Android build.
# VITE_API_BASE=https://your-app.vercel.app

# Optional: allowed cross-origin callers for the /api proxy (comma-separated).
# Needed only for the native app calling a remote VITE_API_BASE.
# ALLOWED_ORIGINS=capacitor://localhost,https://localhost
